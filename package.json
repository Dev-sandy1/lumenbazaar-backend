{
  "name": "lumenbazaar-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm prisma:generate && pnpm typecheck",
    "check": "pnpm prisma:generate && pnpm openapi:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm prisma:validate",
    "dev:api": "tsx apps/api/src/main.ts",
    "dev:mcp": "tsx apps/mcp-server/src/main.ts",
    "dev:worker": "tsx apps/worker/src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "load:test": "tsx scripts/loadtest.ts",
    "openapi:check": "tsx scripts/openapi.ts --check",
    "openapi:generate": "tsx scripts/openapi.ts",
    "prisma:generate": "node scripts/prisma.mjs generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "node scripts/prisma.mjs validate",
    "payments:persistence:test": "vitest run --passWithNoTests prismaPaymentPersistence.integration.test.ts settlementConcurrency.integration.test.ts",
    "deploy:testnet:check": "tsx scripts/deployment-check.ts --env-file config/testnet.release.env",
    "deploy:testnet:check:example": "tsx scripts/deployment-check.ts --env-file .env.testnet.example --allow-placeholders",
    "deploy:testnet:probe": "tsx scripts/testnet-probe.ts --manifest docs/deployment/testnet-endpoints.json",
    "deploy:testnet:exact": "tsx scripts/testnet-exact-gate.ts --manifest docs/deployment/testnet-endpoints.json",
    "catalog:testnet:seed": "tsx scripts/catalog-testnet-resources.ts",
    "start": "tsx apps/api/src/main.ts",
    "start:api": "tsx apps/api/src/main.ts",
    "start:mcp": "tsx apps/mcp-server/src/main.ts",
    "start:mcp:http": "tsx apps/mcp-server/src/http.ts",
    "start:worker": "tsx apps/worker/src/main.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@prisma/client": "6.19.3",
    "@stellar/stellar-sdk": "17.2.1",
    "@x402/core": "2.28.0",
    "@x402/stellar": "2.28.0",
    "bullmq": "5.65.0",
    "fastify": "5.12.5",
    "ioredis": "5.8.2",
    "pino": "10.1.0",
    "prom-client": "15.1.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "prettier": "3.7.4",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.20.0",
      "deepmerge-ts": "8.0.0"
    }
  }
}
