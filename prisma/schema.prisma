generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Seller {
  id               String           @id @default(cuid())
  displayName      String
  walletAddress    String           @unique
  domain           String
  domainVerifiedAt DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  domains          SellerDomain[]
  resources        Resource[]
  paymentAttempts  PaymentAttempt[]
  paymentSessions  PaymentSession[]
  receipts         Receipt[]
  catalogEvents    CatalogEvent[]
  mcpServers       McpServer[]
  searchDocuments  SearchDocument[]
  webhookEndpoints WebhookEndpoint[]
  webhookEvents    WebhookEvent[]
  apiKeys          SellerApiKey[]

  @@index([domain])
}

model SellerApiKey {
  id           String    @id @default(cuid())
  sellerId     String
  name         String
  keyPrefix    String    @db.VarChar(32)
  keyHash      String    @unique
  scopes       Json
  status       String    @default("active")
  expiresAt    DateTime?
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  rotatedOutAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  seller       Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, status])
  @@index([keyPrefix])
}

model SellerDomain {
  id                 String    @id @default(cuid())
  sellerId           String
  domain             String
  verificationMethod String
  challengeToken     String
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  seller             Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, domain])
  @@index([domain])
}

model Resource {
  id                  String               @id @default(cuid())
  sellerId            String
  type                String
  name                String
  description         String
  url                 String
  routeTemplate       String
  network             String
  payTo               String
  assetCode           String
  assetIssuer         String
  amount              Decimal              @db.Decimal(24, 7)
  inputSchema         Json
  outputSchema        Json
  extensions          Json
  status              String               @default("active")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  seller              Seller               @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  versions            ResourceVersion[]
  schemas             ResourceSchema[]
  paymentRequirements PaymentRequirement[]
  paymentAttempts     PaymentAttempt[]
  paymentSessions     PaymentSession[]
  receipts            Receipt[]
  catalogEvents       CatalogEvent[]
  mcpTools            McpTool[]
  searchDocument      SearchDocument?

  @@index([sellerId])
  @@index([network, assetCode])
  @@index([type, status])
}

model ResourceVersion {
  id         String   @id @default(cuid())
  resourceId String
  version    Int
  metadata   Json
  createdAt  DateTime @default(now())
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, version])
}

model ResourceSchema {
  id           String   @id @default(cuid())
  resourceId   String
  inputSchema  Json
  outputSchema Json
  createdAt    DateTime @default(now())
  resource     Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model PaymentRequirement {
  id          String   @id @default(cuid())
  resourceId  String
  scheme      String
  network     String
  assetCode   String
  assetIssuer String
  amount      Decimal  @db.Decimal(24, 7)
  payTo       String
  createdAt   DateTime @default(now())
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([network, assetCode])
  @@index([payTo])
}

model PaymentAttempt {
  id              String      @id @default(cuid())
  correlationId   String      @db.VarChar(64)
  resourceId      String?
  sellerId        String?
  paymentHash     String      @unique
  idempotencyKey  String      @unique
  network         String
  assetCode       String
  assetIssuer     String
  amount          Decimal     @db.Decimal(24, 7)
  payTo           String
  status          String      @default("received")
  failureCode     String?
  failureReason   String?
  expiresAtLedger Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  resource        Resource?   @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  seller          Seller?     @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  settlement      Settlement?
  receipt         Receipt?

  @@index([network, status])
  @@index([sellerId, status])
  @@index([resourceId, status])
  @@index([correlationId])
}

model Settlement {
  id                     String         @id @default(cuid())
  correlationId          String         @db.VarChar(64)
  paymentAttemptId       String         @unique
  transactionHash        String?        @unique
  ledger                 Int?
  network                String
  amount                 Decimal        @db.Decimal(24, 7)
  assetCode              String
  assetIssuer            String
  status                 String         @default("pending")
  reconciliationState    String         @default("not_required")
  reconciliationReason   String?
  reconciliationAttempts Int            @default(0)
  lastReconciledAt       DateTime?
  settledAt              DateTime?
  createdAt              DateTime       @default(now())
  paymentAttempt         PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)

  @@index([network, status])
  @@index([ledger])
  @@index([reconciliationState, lastReconciledAt])
  @@index([correlationId])
}

model Receipt {
  id               String         @id @default(cuid())
  correlationId    String         @db.VarChar(64)
  paymentAttemptId String         @unique
  resourceId       String?
  sellerId         String?
  transactionHash  String?
  ledger           Int?
  network          String
  amount           Decimal        @db.Decimal(24, 7)
  assetCode        String
  assetIssuer      String
  status           String         @default("pending")
  settledAt        DateTime?
  failureCode      String?
  failureReason    String?
  evidenceHash     String         @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  paymentAttempt   PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  resource         Resource?      @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  seller           Seller?        @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  @@index([network, status])
  @@index([sellerId, status])
  @@index([resourceId, status])
  @@index([transactionHash])
  @@index([correlationId])
}

model PaymentSession {
  id                String                  @id @default(cuid())
  resourceId        String?
  sellerId          String?
  network           String
  buyer             String
  payTo             String
  assetCode         String
  assetIssuer       String
  assetContractId   String
  capAmount         Decimal                 @db.Decimal(24, 7)
  spentAmount       Decimal                 @db.Decimal(24, 7)
  remainingAmount   Decimal                 @db.Decimal(24, 7)
  contractId        String
  contractSessionId String                  @unique
  resourceHash      String
  expiresAtLedger   Int
  status            String                  @default("open")
  transactionHash   String?
  ledger            Int?
  usageHash         String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  resource          Resource?               @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  seller            Seller?                 @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  settlements       UptoSessionSettlement[]

  @@index([network, status])
  @@index([sellerId, status])
  @@index([resourceId, status])
  @@index([contractId])
  @@index([expiresAtLedger])
}

model UptoSessionSettlement {
  id              String         @id @default(cuid())
  sessionId       String
  network         String
  amount          Decimal        @db.Decimal(24, 7)
  transactionHash String         @unique
  ledger          Int
  usageHash       String
  status          String         @default("settled")
  settledAt       DateTime
  createdAt       DateTime       @default(now())
  session         PaymentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([network, status])
  @@index([ledger])
  @@index([usageHash])
}

model CatalogEvent {
  id         String    @id @default(cuid())
  resourceId String?
  sellerId   String?
  type       String
  status     String
  reason     String?
  metadata   Json
  createdAt  DateTime  @default(now())
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  seller     Seller?   @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  @@index([resourceId, createdAt])
  @@index([sellerId, createdAt])
  @@index([type, status])
}

model McpServer {
  id        String    @id @default(cuid())
  sellerId  String?
  name      String
  baseUrl   String
  status    String    @default("active")
  metadata  Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  seller    Seller?   @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  tools     McpTool[]

  @@index([sellerId, status])
}

model McpTool {
  id           String    @id @default(cuid())
  serverId     String
  resourceId   String?
  name         String
  description  String
  inputSchema  Json
  outputSchema Json
  metadata     Json
  createdAt    DateTime  @default(now())
  server       McpServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  resource     Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@unique([serverId, name])
  @@index([resourceId])
}

model SearchDocument {
  id         String    @id @default(cuid())
  resourceId String    @unique
  sellerId   String
  body       String
  ranking    Json
  indexedAt  DateTime?
  stale      Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resource   Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  seller     Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([stale])
}

model ConformanceRun {
  id          String    @id @default(cuid())
  network     String
  suite       String
  status      String
  results     Json
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([network, status])
  @@index([createdAt])
}

model NetworkStatus {
  id             String   @id @default(cuid())
  network        String   @unique
  status         String
  latestLedger   Int?
  rpcHealthy     Boolean  @default(false)
  horizonHealthy Boolean  @default(false)
  checkedAt      DateTime @default(now())
  metadata       Json

  @@index([status])
}

model ApiClient {
  id            String           @id @default(cuid())
  name          String
  publicKey     String?          @unique
  status        String           @default("active")
  rateLimitTier String           @default("default")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  rateLimits    RateLimitEvent[]

  @@index([status, rateLimitTier])
}

model RateLimitEvent {
  id          String     @id @default(cuid())
  apiClientId String?
  route       String
  key         String
  limit       Int
  remaining   Int
  resetAt     DateTime
  createdAt   DateTime   @default(now())
  apiClient   ApiClient? @relation(fields: [apiClientId], references: [id], onDelete: SetNull)

  @@index([apiClientId, createdAt])
  @@index([route, createdAt])
  @@index([key, createdAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  correlationId String? @db.VarChar(64)
  actorType     String
  actorId       String?
  action        String
  targetType    String
  targetId      String?
  metadata      Json
  createdAt     DateTime @default(now())

  @@index([actorType, actorId])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@index([correlationId])
}

model OperatorConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model WebhookEndpoint {
  id                  String              @id @default(cuid())
  sellerId            String
  url                 String
  isActive            Boolean             @default(true)
  lastDeliveryAt      DateTime?
  lastDeliveryStatus  Int?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  seller              Seller              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  secrets             WebhookSecret[]
  deliveryAttempts    WebhookDeliveryAttempt[]

  @@index([sellerId, isActive])
  @@index([createdAt])
}

model WebhookSecret {
  id                 String             @id @default(cuid())
  endpointId         String
  secretHash         String
  isCurrent          Boolean            @default(true)
  createdAt          DateTime           @default(now())
  rotatedOutAt       DateTime?
  endpoint           WebhookEndpoint    @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, isCurrent])
  @@index([endpointId, rotatedOutAt])
}

model WebhookEvent {
  id                  String              @id @default(cuid())
  eventId             String              @unique
  sellerId            String
  eventType           String
  paymentAttemptId    String
  settlementId        String
  status              String
  payload             Json
  createdAt           DateTime            @default(now())
  seller              Seller              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  deliveryAttempts    WebhookDeliveryAttempt[]

  @@index([sellerId, createdAt])
  @@index([eventId])
  @@index([paymentAttemptId])
  @@index([settlementId])
  @@index([eventType, createdAt])
}

model WebhookDeliveryAttempt {
  id                 String            @id @default(cuid())
  eventId            String
  endpointId         String
  attemptNumber      Int
  requestUrl         String
  requestHeaders     Json
  statusCode         Int?
  responseBodyTruncated String?
  latencyMs          Int
  errorClass         String?
  createdAt          DateTime          @default(now())
  event              WebhookEvent      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint           WebhookEndpoint   @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([eventId, attemptNumber])
  @@index([endpointId, createdAt])
  @@index([createdAt])
}

model OutboxEvent {
  id                 String            @id @default(cuid())
  aggregateType      String            // "settlement", "receipt", "resource", "catalog"
  aggregateId        String            // settlement/receipt/resource/catalogEvent ID
  eventType          String            // "settlement.confirmed", "receipt.finalized", "resource.indexed", etc.
  payloadVersion     Int               @default(1)
  payload            Json              // Event data - allowlisted fields only, no secrets
  status             String            @default("pending") // "pending", "processing", "delivered", "dead"
  attemptCount       Int               @default(0)
  nextAttemptAt      DateTime          @default(now())
  lockedBy           String?           // Worker ID claiming the batch
  lockExpiresAt      DateTime?         // Lease expiry for crash recovery
  lastError          String?           // Truncated error message (max 500 chars), redacted
  deliveredAt        DateTime?         // When status changed to "delivered"
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([aggregateType, aggregateId, eventType, createdAt]) // Prevents duplicate events for same aggregate transition
  @@index([status, nextAttemptAt]) // Relay query: find next batch to process
  @@index([status, createdAt]) // Cleanup query: find delivered events to remove
  @@index([aggregateType, aggregateId]) // Find events for specific aggregate
  @@index([lockedBy, lockExpiresAt]) // Find stale locks for recovery
}

model ProcessedOutboxEvent {
  id                 String            @id @default(cuid())
  outboxEventId      String            @unique // Foreign key to OutboxEvent
  aggregateType      String
  aggregateId        String
  eventType          String
  consumerId         String            // Handler that processed this event (e.g., "settlement.relay", "catalog.indexer")
  processedAt        DateTime          @default(now())

  @@unique([outboxEventId, consumerId]) // Idempotency: same event+consumer combo never processed twice
  @@index([aggregateType, aggregateId, consumerId])
}

