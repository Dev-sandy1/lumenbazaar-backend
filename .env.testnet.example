NODE_ENV=production
LUMEN_ENV=testnet
API_HOST=0.0.0.0
API_PORT=3000
API_PUBLIC_URL=https://api.testnet.lumenbazaar.example
CORS_ALLOWED_ORIGINS=https://frontend.testnet.lumenbazaar.example
MCP_HOST=0.0.0.0
MCP_PORT=3001
MCP_PATH=/mcp
MCP_TRUST_PROXY=true
MCP_PUBLIC_URL=https://mcp.testnet.lumenbazaar.example/mcp
API_BASE_URL=https://api.testnet.lumenbazaar.example
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/lumenbazaar
REDIS_URL=redis://redis:6379
ENABLE_UPTO_SCHEME=false

# Asset selection for exact testnet payments.
# Set to "usdc" (default) for official Stellar testnet USDC, or "lbt" for custom test-only asset.
# See TESTNET_ASSET_* below for configuration of each asset.
TESTNET_ASSET=usdc

# Official Stellar testnet USDC configuration.
# Issuer: Circle's official testnet USDC issuer (https://developers.circle.com/stablecoins/quickstarts/transfer-usdc-stellar)
# To deploy a Soroban contract for this asset, use: stellar contract id asset USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5 --network testnet
STELLAR_TESTNET_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
STELLAR_TESTNET_USDC_CONTRACT_ID=REPLACE_ME

# Custom Lumen Bazaar test-only asset (LBT) — enabled only when TESTNET_ASSET=lbt.
# This is a custom test asset for contract experiments. Do NOT use for production or official deployments.
# Leave empty or comment out when using USDC (the default).
# TESTNET_LBT_ISSUER=REPLACE_ME
# TESTNET_LBT_CONTRACT_ID=REPLACE_ME

STELLAR_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_TESTNET_UPTO_SESSION_CONTRACT_ID=
STELLAR_PUBNET_RPC_URL=https://mainnet.sorobanrpc.com
STELLAR_PUBNET_HORIZON_URL=https://horizon.stellar.org
STELLAR_PUBNET_USDC_ISSUER=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF
STELLAR_PUBNET_USDC_CONTRACT_ID=
STELLAR_PUBNET_UPTO_SESSION_CONTRACT_ID=
FACILITATOR_ACCOUNT=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF
FACILITATOR_SIGNER_PROVIDER=environment
FACILITATOR_SIGNER_NETWORK=stellar:testnet
FACILITATOR_SIGNING_KEY_VERSION=REPLACE_ME
FACILITATOR_SIGNING_KEY=
STELLAR_MAX_TRANSACTION_FEE_STROOPS=50000
STELLAR_INCLUSION_FEE_STROOPS=100
EVENT_STREAM_SIGNING_SECRET=
